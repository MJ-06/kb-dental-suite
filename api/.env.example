# Copy to .env. `npm run db:bootstrap` writes a real .env for this machine.

# The app connects as kb_app: not the table owner, no BYPASSRLS, so row level
# security always applies to it.
DATABASE_URL=postgres://kb_app:CHANGE_ME@localhost:5432/kb_pms
# Tests use their own database, wiped on every run.
TEST_DATABASE_URL=postgres://kb_app:CHANGE_ME@localhost:5432/kb_pms_test
# OWNER_DATABASE_URL and TEST_OWNER_DATABASE_URL (kb_owner, which owns the
# tables) live in ~/.kb-pms/owner.env, never here.

PORT=8080
HOST=127.0.0.1
# Set true behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Optional: lets doctors draft the consent narrative. Leave unset to switch it off.
# ANTHROPIC_API_KEY=
# SOAP_MODEL=claude-sonnet-5-5
