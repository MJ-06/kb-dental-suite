# Copy to .env. `npm run db:bootstrap` writes a real .env for this machine.

# The app connects as kb_app: not the table owner, no BYPASSRLS, so row level
# security always applies to it.
DATABASE_URL=postgres://kb_app:CHANGE_ME@localhost:5432/kb_pms
# Tests use their own database, wiped on every run.
TEST_DATABASE_URL=postgres://kb_app:CHANGE_ME@localhost:5432/kb_pms_test
# OWNER_DATABASE_URL and TEST_OWNER_DATABASE_URL (kb_owner, which owns the
# tables) live in ~/.kb-pms/owner.env, never here.

PORT=8080
HOST=127.0.0.1
# The session cookie is marked Secure unless this is exactly "false".
# Browsers still accept it on http://localhost and http://127.0.0.1; any
# other address must be served over HTTPS.
COOKIE_SECURE=true
# /exec calls a minute per address (a clinic's desks share one).
# EXEC_RATE_LIMIT=900

# Optional: lets doctors draft the consent narrative. Leave unset to switch it off.
# ANTHROPIC_API_KEY=
# SOAP_MODEL=claude-sonnet-5-5

# Where uploaded patient files live (default: ~/.kb-pms/documents, outside the repo).
# DOCUMENT_DIR=
# Full path to Edge or Chrome, to turn printed documents into PDFs. Leave unset to switch PDF export off.
# PDF_BROWSER=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

# Seals each clinic's bucket keys and Google Drive sign-in before they are stored. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: without it the stored credentials must be entered again. Never commit it.
# KB_SECRETS_KEY=
# Only for a local test bucket (MinIO) or the test suite: allow plain http / loopback storage addresses.
# STORAGE_ALLOW_LOCAL_ENDPOINTS=true
