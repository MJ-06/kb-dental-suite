{
  "name": "kb-pms-api",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-clinic PMS API: TypeScript, Fastify, PostgreSQL 18 with row level security.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "db:reset-dev": "tsx scripts/reset-dev.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/standalone": "7.29.11",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.7",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
